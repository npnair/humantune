{
  "manifest_version": 3,
  "name": "HumanTune: AI Song Blocker",
  "version": "0.3.0",
  "description": "Automatically skips AI-generated songs on the Spotify Web Player. Toggle it on or off anytime.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://raw.githubusercontent.com/*",
    "https://gist.githubusercontent.com/*",
    "https://musicbrainz.org/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "HumanTune",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "lib/core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}